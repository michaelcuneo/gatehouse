{
  "name": "gatehouse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @gatehouse/web dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "dev:turbo": "turbo run dev",
    "setup:linux": "sudo bash install/linux/install.sh"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest",
    "prettier": "latest",
    "@types/node": "^22.0.0"
  }
}
